  nurseOutlineColor: {r: 0.92, g: 0.96, b: 0.94, a: 0.6}
  dialogueLines:
  - speakerName: "\u5ABD\u5ABD"
    content: "\u597D\u7684\u9EBB\u7169\u59B3\u4E86"
  - speakerName: "\u82BD\u82BD"
    content: "\u6211\u4E0D\u8981\uFF01\u6211\u4E0D\u8981\u6253\u91DD\uFF01"
  - speakerName: "\u5ABD\u5ABD"
    content: "\u4E0D\u597D\u610F\u601D\uFF0C\u82BD\u82BD\u4EE5\u70BA\u4F60\u5011\u9032\u4F86\u5C31\u662F\u8981\u6253\u91DD\uFF01"
  - speakerName: "\u5ABD\u5ABD"
    content: "\u4F86 \u82BD\u82BD\u8EBA\u8EBA\u4E0B \u6211\u5011\u4F86\u807D\u5152\u6B4C"
  - speakerName: "\u5ABD\u5ABD"
    content: "\u59CA\u59CA\u5728\u65C1\u908A\u770B\u6211\u5011\u5C31\u597D\uFF01"
  - speakerName: "\u5ABD\u5ABD"
    content: "\u597D\u68D2\u5594\uFF01\u6709\u8CBC\u7D19\u8036\uFF01\u6211\u5011\u8B93\u59CA\u59CA\u807D\u807D\uFF01"
  - speakerName: "\u82BD\u82BD"
    content: "\"\u6211\u4E0D\u8981\uFF01\u6211\u8AAA\u6211\u4E0D\u8981\uFF01\""
  - speakerName: "\u5ABD\u5ABD"
    content: "\"\u90A3\u82BD\u82BD\u7576\u91AB\u751F\u807D\u5ABD\u5ABD\u5ABD\u7684\u5FC3\u8DF3
      \u4F86 \u807D\u8A3A\u5668\u7D66\u59B3\uFF01\""
  - speakerName: "\u5ABD\u5ABD"
    content: "\"\u6709\u6C92\u6709\u807D\u5230\u64B2\u901A\u64B2\u901A\u7684\u8072\u97F3\uFF5E\""
  - speakerName: "\u82BD\u82BD"
    content: "\"\u82BD\u82BD\u7684\u8033\u6735\u75DB\u75DB...\""
  - speakerName: "\u5ABD\u5ABD"
    content: "\"\u54C7\u5BF6\u8C9D\u597D\u68D2\u54C7\u5594\uFF01\""
  - speakerName: "\u5ABD\u5ABD"
    content: "\"\u4F60\u770B\u6709\u8CBC\u7D19\u8036 \u90A3\u6211\u5011\u8B93\u59CA\u59CA\u91CF\u4E00\u4E0B\u597D\u4E0D\u597D\u54C7\""
  - speakerName: "\u82BD\u82BD"
    content: "\"\u4F60\u8D70\u958B\uFF01\u6211\u4E0D\u8981\u554A\uFF01\uFF01\uFF01\uFF01\""
  - speakerName: "\u5ABD\u5ABD"
    content: "\"\u59B3\u600E\u9EBC\u9019\u9EBC\u6C92\u79AE\u8C8C...\""
  - speakerName: "\u5ABD\u5ABD"
    content: "\"\u82BD\u82BD\u59B3\u5225\u6015 \u5ABD\u5ABD\u5728\u9019\u88E1\u966A\u59B3\""
  - speakerName: "\u82BD\u82BD"
    content: "\"\u54FC \u6211\u4E0D\u8981\u91CF\uFF01\u5C0F\u718A\u4E5F\u4E0D\u8981\uFF01\""
  - speakerName: "\u82BD\u82BD"
    content: "\"\u6211\u4E0D\u60F3\u8981 \u4E0D\u60F3\u8981\uFF01 \u6211\u4E0D\u8981\uFF01\uFF01\u8A0E\u53AD\u4F60\uFF01\""
  - speakerName: "\u82BD\u82BD"
    content: "\"\u5C0F\u718A\u9019\u500B\u4E0D\u6703\u75DB\u7684\uFF01\u4E0D\u7528\u6015\u5466\""
  - speakerName: "\u82BD\u82BD"
    content: "\"\u53EA\u6709\u51B0\u51B0\u7684\u611F\u89BA \u4E0D\u6703\u75DB\u75DB
      \_\u4E00\u4E0B\u4E0B\u5C31\u597D\u4E86\uFF5E\""
  - speakerName: "\u82BD\u82BD"
    content: "\"\u55DA\u55DA\u55DA \u5ABD\u54AA\u62B1\u62B1\""
  - speakerName: "\u5ABD\u5ABD"
    content: "\"\u6211\u5011\u7684\u82BD\u82BD\u90A3\u9EBC\u52C7\u6562\uFF01\""
  - speakerName: "\u5ABD\u5ABD"
    content: "\"\u8DDF\u5C0F\u718A\u4E00\u6A23\u68D2\u68D2\u5660 \u8B93\u59CA\u59CA\u4E5F\u91CF\u4E00\u4E0B\u9AD4\u6EAB\u597D\u4E0D\u597D\""
  - speakerName: "\u82BD\u82BD"
